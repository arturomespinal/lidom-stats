# Variables de la API para PRODUCCIÓN. Ver api/seguridad.py.
# La API no lee este archivo: se ponen en el entorno del servidor (el panel del
# hosting, el servicio de systemd, docker-compose…). Este archivo es la lista.
# Nunca subir al repositorio un .env con las claves de verdad.
#
# En Oracle Cloud, deploy/oracle/instalar.sh escribe /etc/deportiv/api.env con
# estas mismas variables y claves nuevas. Ver deploy/oracle/GUIA.md.

LIDOM_ENTORNO=produccion

# Orígenes de la web que pueden llamar a la API desde el navegador.
LIDOM_CORS_ORIGINS=https://deportiv.do,https://www.deportiv.do

# Peticiones por IP y minuto (300 por defecto en producción).
LIDOM_LIMITE_POR_MINUTO=300

# "1" SOLO si la API va detrás de un proxy (Caddy, Nginx, Cloudflare…) y no
# se puede llegar a ella sin pasar por él. En Oracle va en 1: Caddy delante.
LIDOM_CONFIAR_PROXY=0

# Claves de 24+ caracteres, distintas entre sí. Para generarlas:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# La de diagnóstico abre /health completo y /live/status (cabecera
# X-Clave-Diagnostico). La del servidor va TAMBIÉN en el entorno del servidor
# de Next (sin prefijo NEXT_PUBLIC_) y lo exime del límite por IP.
LIDOM_CLAVE_DIAGNOSTICO=
LIDOM_CLAVE_SERVIDOR=

# Motor en vivo durante la temporada.
LIDOM_LIVE_POLLER=1

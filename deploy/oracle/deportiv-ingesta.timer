# Cada madrugada a las 4:00 de RD, de octubre a febrero (la temporada, el
# round robin, la final y la Serie del Caribe). A esa hora ningún juego está
# en curso, y queda media hora antes del respaldo de las 4:30, que así guarda
# la base ya al día. Fuera de esos meses no hay nada que traer.
# Persistent: si la máquina estaba apagada a esa hora, corre al encender.

[Unit]
Description=Ingesta diaria de Deportiv

[Timer]
OnCalendar=*-10,11,12,01,02-* 04:00:00 America/Santo_Domingo
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
